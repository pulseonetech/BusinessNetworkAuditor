{
  "version": "1.2",
  "description": "Report presentation configuration - controls grouping, formatting, and display preferences",

  "section_labels": {
    "high_risk": "High Risk Items",
    "medium_risk": "Medium Risk Items",
    "low_risk": "Info Items"
  },

  "display_limits": {
    "max_systems_per_finding": 5,
    "show_summary_when_exceeded": true
  },

  "grouping": {
    "combine_per_system": [
      "Critical Role Detected",
      "Server Role",
      "Remote Access Software",
      "RMM Software"
    ],
    "domain_wide_findings": [
      "User Account Summary",
      "Disabled Domain Accounts",
      "Password Age Analysis",
      "Stale User Accounts",
      "Stale Computer Accounts"
    ],
    "normalize_risk_levels": [
      "Local Administrators",
      "Domain Admins",
      "Failed Logon",
      "Critical Role Detected",
      "Server Role"
    ]
  },

  "omit_from_report": [
    "Wireless Profiles",
    "Wireless Profile",
    "Network Discovery",
    "DNS Configuration",
    "DNS Config",
    "IP Configuration",
    "IP Config",
    "Printer",
    "Printers",
    "Print Services",
    "Windows Update Service",
    "Update Service",
    "Computer Account Summary",
    "Open Ports"
  ],

  "demote_to_info": [
    "Recent Patches",
    "Recently Applied Patches",
    "Windows Update Configuration",
    "Automatic Updates",
    "Privileged Group",
    "Stale Computer Accounts",
    "Stale User Accounts",
    "Domain Status"
  ],

  "demote_to_medium": [
    "Low Disk Space",
    "Disk Space"
  ],

  "server_exclusions": [
    "BitLocker Encryption"
  ],

  "thresholds": {
    "application_errors_min": 50,
    "system_uptime_days_min": 30,
    "available_updates": 10
  },

  "default_windows_ports": [
    135, 137, 138, 139, 445, 3389, 5985, 5986
  ],

  "recommendations": {
    "Screen Lock": "Configure automatic screen lock after 15 minutes of inactivity via Group Policy or MDM",
    "Screen Lock Policy": "Configure automatic screen lock after 15 minutes of inactivity via Group Policy or MDM",
    "Update Status": "Review pending updates and schedule maintenance window for installation",
    "Available Updates": "Schedule maintenance window to install pending updates",
    "Audit Policy": "Enable audit policies for: Account Logon, Logon/Logoff, Object Access, Policy Change, Privilege Use, and System events",
    "Audit Policy Configuration": "Enable audit policies for: Account Logon, Logon/Logoff, Object Access, Policy Change, Privilege Use, and System events",
    "Stale User Accounts": "Review and disable or remove user accounts that have not logged in for 90+ days",
    "Stale Computer Accounts": "Review and remove computer accounts that have not connected for 90+ days"
  },

  "formatting": {
    "BitLocker Encryption": {
      "show_system_context": true,
      "context_template": "WARNING: {unencrypted_count} of {total_count} workstations lack full disk encryption",
      "workstation_only": true
    },
    "FileVault Encryption": {
      "show_system_context": true,
      "context_template": "WARNING: {unencrypted_count} of {total_count} systems lack full disk encryption"
    },
    "Risky Open Ports": {
      "show_port_details": true,
      "exclude_default_ports": true
    }
  },

  "security_strengths": {
    "categories": {
      "Malware Protection": {
        "finding_patterns": ["*Antivirus*", "*AV Protection*", "*Antivirus Product*"],
        "format": "{Value}",
        "show_per_system": true
      },
      "Remote Access Security": {
        "finding_patterns": ["*Remote Desktop*", "*RDP*"],
        "require_value_match": "*Disabled*",
        "format": "Remote Desktop Disabled",
        "show_system_count": true
      },
      "Account Security": {
        "finding_patterns": ["*Guest Account*"],
        "require_value_match": "*Disabled*",
        "format": "Guest Account Disabled",
        "show_system_count": true
      },
      "Access Control": {
        "finding_patterns": ["*User Account Control*", "*UAC*"],
        "require_value_match": "*Enabled*",
        "format": "UAC Enabled",
        "show_system_count": true
      },
      "Data Encryption": {
        "finding_patterns": ["*BitLocker*", "*FileVault*"],
        "require_details_match": "*Encrypted*",
        "format": "{EncryptionType} Encryption",
        "show_per_system": true
      },
      "Enterprise Management": {
        "finding_patterns": ["*Domain Membership*"],
        "exclude_values": ["*Workgroup*"],
        "format": "Domain: {Value}",
        "show_system_count": true
      },
      "Data Protection": {
        "finding_patterns": ["*Time Machine*", "*Backup*"],
        "require_details_match": "*Last backup*|*enabled*",
        "show_per_system": true
      }
    },
    "exclude_default_features": [
      "*Gatekeeper*",
      "*System Integrity Protection*",
      "*SIP*",
      "*XProtect*"
    ]
  },

  "technical_debt": {
    "note": "The following are temporary band-aids that should be removed once audits are fixed",
    "temporary_filters": [
      {
        "pattern": "*Windows Defender*",
        "reason": "Baseline feature, not a finding",
        "action": "Exclude"
      },
      {
        "item": "Share Permission Risk",
        "reason": "Redundant with File Share",
        "action": "Exclude"
      },
      {
        "item": "BitLocker Volume",
        "reason": "Redundant with BitLocker Encryption",
        "action": "Exclude"
      },
      {
        "item": "BitLocker Encryption Summary",
        "reason": "Redundant with BitLocker Encryption",
        "action": "Exclude"
      },
      {
        "item": "File Share",
        "condition": "value matches NETLOGON|SYSVOL",
        "reason": "Required DC shares flagged as risky",
        "action": "Exclude when condition met"
      },
      {
        "item": "Remote Desktop",
        "condition": "value matches Disabled",
        "reason": "Disabled RDP is a strength, not a risk",
        "action": "Move to security strengths"
      },
      {
        "item": "Guest Account",
        "condition": "value matches Disabled",
        "reason": "Disabled Guest is a strength, not a risk",
        "action": "Move to security strengths"
      }
    ]
  }
}
